POSTGRES_DB=model_archive
POSTGRES_USER=model_archive
POSTGRES_PASSWORD=change-me-before-sharing
POSTGRES_PORT=15432
API_PORT=18000
ADMINER_PORT=18080

# Source-ingestion model providers (used by tools/*.py).
# Existing shell environment variables take precedence over these values.
ASR_PROVIDER=local
ASR_LANGUAGE=zh
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# For OpenAI-compatible hosted ASR, use compatible-chat and fill both values.
ASR_API_KEY=
ASR_BASE_URL=
COMPATIBLE_ASR_MODEL=qwen3-asr-flash

# Product extraction LLM. Set LLM_PROVIDER=none for metadata-only fallback CSVs.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=Qwen3.5-35B-A3B
LLM_MAX_TOKENS=4096

# Optional OpenAI-compatible transcription fallback.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
