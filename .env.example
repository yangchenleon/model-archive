POSTGRES_DB=model_archive
POSTGRES_USER=model_archive
POSTGRES_PASSWORD=change-me-before-sharing
POSTGRES_PORT=15432
API_PORT=18000
ADMINER_PORT=18080
FRONTEND_PORT=5173

# Photo object storage (S3 API). The app only knows the S3 interface, so the
# backend can be Garage (compose service `objects`), MinIO, SeaweedFS or R2.
# PHOTO_STORAGE=fs keeps bytes in a local directory instead (tests use this).
PHOTO_STORAGE=s3
S3_ENDPOINT_URL=http://objects:3900
S3_BUCKET=model-archive-photos
# Garage key: "GK" + 24 hex; secret: 64 hex. Dev values, change if exposed.
S3_ACCESS_KEY=GK0123456789abcdef01234567
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_REGION=garage
OBJECTS_PORT=18333

# Source-ingestion model providers (used by tools/*.py).
# Existing shell environment variables take precedence over these values.
# Remote Qwen ASR.
ASR_LANGUAGE=zh
ASR_MODEL=qwen3-asr-flash

# DashScope-compatible Qwen ASR.
ASR_API_KEY=
ASR_BASE_URL=

# Product extraction LLM. Set LLM_PROVIDER=none for metadata-only fallback CSVs.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=Qwen3.5-35B-A3B
LLM_MAX_TOKENS=4096
